#compdef inbox
# zsh completion for the inbox command. scripts/install.sh links it into
# oh-my-zsh's completions directory. Channel names come from `inbox channels`
# of the plugin on the line, so only channels with unseen messages are offered.

# The --plugin words of the whole line. _inbox_line keeps the line from
# before _arguments narrows $words to the command's own words.
_inbox_plugin() {
  local i
  reply=()
  for ((i = 1; i <= $#_inbox_line; i++)); do
    case $_inbox_line[i] in
      --plugin) reply=(--plugin $_inbox_line[i+1]) ;;
      --plugin=*) reply=($_inbox_line[i]) ;;
    esac
  done
}

_inbox_channels() {
  local -a channels db reply
  [[ -n ${opt_args[--db]} ]] && db=(--db ${opt_args[--db]})
  _inbox_plugin
  channels=(${(f)"$(command $_inbox_line[1] channels $db $reply 2>/dev/null | awk '{print $1}')"})
  _describe -t channels 'channel' channels
}

# The apps of $INBOX_APPS_ROOT: its folders that hold a .git folder.
_inbox_apps() {
  local -a apps
  [[ -n $INBOX_APPS_ROOT ]] && apps=(${INBOX_APPS_ROOT}/*/.git(N/:h:t))
  _describe -t apps 'app' apps
}

_inbox_plugins() {
  local -a plugins
  plugins=(${(f)"$(command $_inbox_line[1] plugins 2>/dev/null | awk '{print $1}')"})
  _describe -t plugins 'plugin' plugins
}

_inbox() {
  local curcontext="$curcontext" state line ret=1
  local -a _inbox_line
  _inbox_line=($words)
  typeset -A opt_args
  local -a commands
  commands=(
    'send:send one message'
    'pipe:send each line of standard input as a message'
    'list:list messages, seen and unseen'
    'count:print how many messages are not seen yet'
    'channels:list channels that have unseen messages'
    'channel:print the channel of the working directory'
    'seen:mark messages as seen'
    'here:show or set where a press on a channel key goes'
    'daemon:watch the inbox and show it on the macro pad'
    'plugins:list the plugins'
    'emoji:print the emoji of a folder or a Claude Code session'
    'pin:always show an app key (--plugin apps)'
    'unpin:stop pinning an app (--plugin apps)'
    'run:run an app and report its state (--plugin apps)'
    'help:show help for a command'
  )
  local here='--here=[where a press goes: iterm2:UUID, app:BUNDLE_ID, or url:URL]:here:'
  local db='--db[use this SQLite file instead of $INBOX_DB]:file:_files'
  local plugin='--plugin=[the plugin (default: basic)]:plugin:_inbox_plugins'

  _arguments -C \
    '(-h --help)'{-h,--help}'[show help]' \
    "$plugin" \
    '1: :->command' \
    '*:: :->args' && ret=0

  case $state in
    command)
      _describe -t commands 'inbox command' commands && ret=0
      ;;
    args)
      case $line[1] in
        send)
          _arguments "$db" "$plugin" "$here" '--status=[the status of the message]:status:' \
            '--channel=[the channel]:channel:_inbox_channels' \
            '1::channel:_inbox_channels' && ret=0 ;;
        pipe)
          _arguments "$db" "$plugin" "$here" '--status=[the status of the message]:status:' \
            '--channel=[the channel]:channel:_inbox_channels' \
            '1::channel:_inbox_channels' && ret=0 ;;
        here)
          _arguments "$db" "$plugin" '--clear[remove the fallback of the channel]' \
            '1::channel:_inbox_channels' '2::here:' && ret=0 ;;
        list)
          _arguments "$db" "$plugin" \
            '(--all-channels 1)--all-channels[list every channel]' \
            '--unseen[list only the unseen]' \
            '--json[print JSON]' \
            '-n+[keep the newest N]:count:' \
            '--channel=[the channel]:channel:_inbox_channels' \
            '(--all-channels)1::channel:_inbox_channels' && ret=0 ;;
        count | seen)
          _arguments "$db" "$plugin" \
            '(--all-channels 1)--all-channels[every channel]' \
            '--channel=[the channel]:channel:_inbox_channels' \
            '(--all-channels)1::channel:_inbox_channels' && ret=0 ;;
        channels)
          _arguments "$db" "$plugin" '--json[print JSON]' && ret=0 ;;
        daemon)
          _arguments "$db" '*--plugin=[show only this plugin (default: every plugin)]:plugin:_inbox_plugins' \
            '--port=[macropadd port on 127.0.0.1]:port:' \
            '--assets-dir=[unused: the daemon sends icon text]:directory:_directories' \
            '*--slot=[put a key in this slot: N, or NAME=N per plugin]:slot:(0 1 2 3 4 5)' \
            '--poll=[how often to look for a change]:duration:' && ret=0 ;;
        plugins | channel)
          _arguments "$plugin" && ret=0 ;;
        emoji)
          _arguments "$plugin" \
            '(1 --folder)--channel=[the channel]:channel:_inbox_channels' \
            '(1 --channel)--folder=[the folder]:directory:_directories' \
            '--session=[a Claude Code session id]:session:' \
            '--format=[what to print]:format:(char name ref json)' \
            '(--channel --folder)1::channel:_inbox_channels' && ret=0 ;;
        pin | unpin | run)
          _arguments "$db" "$plugin" '1::app:_inbox_apps' && ret=0 ;;
        help)
          _describe -t commands 'inbox command' commands && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

_inbox "$@"
